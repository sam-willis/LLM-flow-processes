# wandb logging and cache directories

wandb/
# Scratch data stays ignored, but the NOAA source files in data/*.txt are
# tracked -- the presets are generated from them. The directory itself must
# NOT be excluded: git does not descend into an excluded directory, so a bare
# `/data/` would make the `!` rules below unreachable.
/data/*
!/data/*.txt
!/data/README.md
artifacts/
outputs/
old_outputs/
outputs*/
workspace/
figures/
metric_scaling_cache/

